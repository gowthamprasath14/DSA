20. Valid Parentheses

class Solution {
    public boolean isValid(String input) {
        char[] brackets = input.toCharArray();
        Stack<Character> s= new Stack();
        for (char c : brackets){
            if(c=='(' || c=='{' || c=='['){
                s.push(c);
            }
            else{
                if(s.isEmpty()) return false;
                char top = s.peek();
                if ((c == ')' && top == '(') || 
                (c == '}' && top == '{') || 
                (c == ']' && top == '[')) {
                s.pop();
                } 
                else 
                return false;
            }
        }
        return s.isEmpty();
    }
}
