45. Jump Game II

class Solution {
    public int jump(int[] nums) {
        int jump=0,ans=0,end=0,n=nums.length;
        for(int i=0;i<n-1;i++){
            ans=Math.max(ans,nums[i]+i);
            if(i==end){
                jump++;
                end=ans;
            }
        }
        return jump;
    }
}
