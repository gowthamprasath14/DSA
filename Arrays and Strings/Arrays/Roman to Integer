13. Roman to Integer

class Solution {
    public int romanToInt(String s) {
        HashMap<Character,Integer> hash=new HashMap<>();
        hash.put('I',1);
        hash.put('V',5);
        hash.put('X',10);
        hash.put('L',50);
        hash.put('C',100);
        hash.put('D',500);
        hash.put('M',1000);
        int sum=0,prev=0;
        for(int i=s.length()-1;i>=0;i--){
            int curr=hash.get(s.charAt(i));

            if(curr<prev) sum-=curr;
            else sum+=curr;
            
            prev=curr;
        }
        return sum;    
    }
}
