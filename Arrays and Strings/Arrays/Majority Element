169. Majority Element

class Solution {
    public int majorityElement(int[] nums) {
        int n=nums.length;
        int count=0,val=nums[0];
        for(int num : nums){
            if(count==0){
                val=num;
            }
            count+= (num==val) ? 1 : -1;
        }
        return val;
    }
}
