1. Two Sum

class Solution {
    public int[] twoSum(int[] nums, int target) {
        
        HashMap<Integer,Integer> hash=new HashMap<>();
        for(int i=0;i<nums.length;i++){
            int ans=target-nums[i];
                if(hash.containsKey(ans))
                    return new int[]{hash.get(ans),i};
            else
            hash.put(nums[i],i);
            }
        return new int[]{-1,-1};
    }
}
