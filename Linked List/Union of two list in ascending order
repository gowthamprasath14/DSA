class Solution {
    public static Node findUnion(Node head1, Node head2) {
        Node curr1=head1;
        Node curr2=head2;
        while(curr1.next!=null){
            curr1=curr1.next;
        }
        curr1.next=curr2;
        head1=sort(head1);
        return rmdup(head1);
    }
    
    public static Node sort(Node head){
    if(head==null || head.next==null) return head;
    Node curr=null;
    Node slow=head;
    Node fast=head;
    
    while(fast!=null && fast.next!=null){
        curr=slow;
        slow=slow.next;
        fast=fast.next.next;
    }
    curr.next=null;
    Node left=sort(head);
    Node right=sort(slow);
    return merge(left,right);
    }
    
    public static Node merge(Node l1,Node l2){
        Node node=new Node(0);
        Node curr=node;
        while(l1!=null && l2!=null){
            if(l1.data<l2.data){
                curr.next=l1;
                l1=l1.next;
            }
            else{
                curr.next=l2;
                l2=l2.next;
            }
            curr=curr.next;
        }
        if(l1!=null) curr.next=l1;
        if(l2!=null) curr.next=l2;
        
        return node.next;
    }
    
    public static Node rmdup(Node head){
        Node curr=head;
        while(curr!=null && curr.next!=null){
            if(curr.data==curr.next.data) curr.next=curr.next.next;
            else curr=curr.next;
        }
        return head;
    }
}
