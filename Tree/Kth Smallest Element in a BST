230. Kth Smallest Element in a BST

class Solution {
    int count=0;
    int kthsmallest=0;
    public int kthSmallest(TreeNode root, int k) {
        if(root==null||count>=k) return count;
        kthSmallest(root.left,k);
        count++;

        if(count==k) {
        kthsmallest=root.val;
        return kthsmallest;
        }
        
        kthSmallest(root.right,k);
        return kthsmallest;
    }
}
