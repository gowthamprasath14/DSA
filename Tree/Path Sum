112. Path Sum

class Solution {

    private boolean preorder(TreeNode root, int target,int curr){
        if(root==null) return false;
        int sum=root.val+curr;
        if(sum==target && root.left==null && root.right==null) return true;
        return preorder(root.left,target,sum)||preorder(root.right,target,sum);

    }
    public boolean hasPathSum(TreeNode root, int target) {
        int curr=0;
        return preorder(root,target,curr);
    }
}
