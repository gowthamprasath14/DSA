257. Binary Tree Paths

class Solution {
    List<String> ans=new ArrayList<>();
    StringBuilder sb=new StringBuilder();

    private void TreePaths(TreeNode root) {
        
    if(root==null) return;
    int len = sb.length();
    sb.append(root.val);

    if (root.left == null && root.right == null)
            ans.add(sb.toString());
    else{
        sb.append("->");
        TreePaths(root.left);
        TreePaths(root.right);
    }
    sb.setLength(len);
    }

    public List<String> binaryTreePaths(TreeNode root) {
        TreePaths(root);
        return ans;
    }
}
